{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "Modern floor covering the JS features Next/SWC would otherwise polyfill (Array.at, Array.flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/End). Safari 15.4 (Mar 2022) is the binding constraint. NOTE: Next 16 currently injects the core-js polyfills regardless of this floor (confirmed in both Webpack and Turbopack), so this is correct-intent hygiene that should start trimming ~14 KiB once Next honors the target for feature polyfills. Widen only if analytics shows real older-browser traffic.",
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "rm -rf .next/cache/fetch-cache && next build --turbopack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/og": "^0.11.1",
    "culori": "^4.0.2",
    "framer-motion": "^12.38.0",
    "next": "^16.2.4",
    "next-sanity": "^12.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "sanity": "^5.20.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "groq-js": "^1.30.1",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
