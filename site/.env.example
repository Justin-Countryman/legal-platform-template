# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by both root .gitignore and site/.gitignore.

# Sanity project — public, safe to expose to the client bundle
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Production hostname (used as metadataBase for OG/canonical/sitemap URLs)
# e.g. www.example.com  (no protocol, no trailing slash)
NEXT_PUBLIC_SITE_DOMAIN=

# Server-only Sanity read token (drafts + preview). DO NOT prefix with NEXT_PUBLIC_.
# Read-scoped only — never a write token.
SANITY_API_READ_TOKEN=

# Google Search Console verification token (optional). When set, emits the
# `<meta name="google-site-verification">` tag from the root layout. Leave
# blank in dev / preview; populate on production deploy after creating the
# property in Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=

# Shared secret for the Sanity → /api/revalidate webhook. Configure the
# matching value in Sanity dashboard (API → Webhooks → custom header
# `x-sanity-revalidate-secret`). When unset, the webhook returns 500.
SANITY_REVALIDATE_SECRET=
