# Copy this file to .env and fill in real values. `.env` is gitignored.
# Vite reads SANITY_STUDIO_* prefixed vars at build/run time.

# Sanity dataset to target. Leave unset to fall back to "production"
# (the dataset hardcoded as the default in sanity.config.ts +
# sanity.cli.ts). Set to "staging" or another dataset name to point a
# local studio install at a non-production dataset.
SANITY_STUDIO_DATASET=

# Project ID is intentionally still hardcoded — single-client studios
# don't need this env-driven. Kept here for parity with the dataset var.
SANITY_STUDIO_PROJECT_ID=
